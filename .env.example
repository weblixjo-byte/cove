# MongoDB Connection URI (optional: if omitted or unconnectable, automatic in-memory fallback is active)
MONGODB_URI=mongodb://localhost:27017/cove_loyalty

# JWT Secret for Session Signing
JWT_SECRET=cove_coffee_house_super_secure_secret_loyalty_2026_jwt_token

# White-Label Default Store Configuration
NEXT_PUBLIC_DEFAULT_STORE_NAME=Cove Coffee House
NEXT_PUBLIC_DEFAULT_TAGLINE=Artisan Roastery & Specialty Brew Bar
NEXT_PUBLIC_DEFAULT_CURRENCY=KWD
NEXT_PUBLIC_DEFAULT_POINTS_PER_UNIT=10
NEXT_PUBLIC_DEFAULT_DISCOUNT_PER_100_PTS=1.00
NEXT_PUBLIC_DEFAULT_BRAND_COLOR=#2C221E
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#1A5336

# Google OAuth Credentials (for customer login & signup)
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
